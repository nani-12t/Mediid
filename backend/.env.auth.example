# Explicit mode. Supply settings through backend/.env or environment/secret storage.
# This file is a template and is NOT loaded automatically. Never commit real keys.
AUTH_BACKEND=legacy
AUTH_JWT_PRIVATE_KEY=REPLACE_WITH_PRIVATE_RSA_PEM_IN_SECRET_STORAGE
AUTH_JWT_PUBLIC_KEY=REPLACE_WITH_PUBLIC_RSA_PEM
AUTH_JWT_KEY_ID=development-active-key
AUTH_JWT_ISSUER=mediid-auth-development
AUTH_JWT_AUDIENCE=mediid-api-development
AUTH_JWT_TTL_SECONDS=900
AUTH_BCRYPT_COST=12
AUTH_RESET_TTL_SECONDS=900
# Approved retiring PUBLIC keys only: JSON object of kid to PEM, max five.
AUTH_JWT_PREVIOUS_PUBLIC_KEYS={}
# PostgreSQL mode additionally requires the runtime URL in .env.postgres.example,
# all seven migrations deployed by the separate migrator, and the settings below.
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# lax for same-site; production cross-site requires none + HTTPS/Secure.
AUTH_COOKIE_SAME_SITE=lax
AUTH_REDIS_URL=redis://127.0.0.1:6379/0
AUTH_RATE_KEY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_SHARED_BY_APP_INSTANCES
# Each operation LOGIN, REGISTER, RESET_REQUEST, RESET_COMPLETE, REFRESH,
# ACTIVATE, PROVISION accepts *_WINDOW_MS, *_SOURCE_MAX, *_IDENTITY_MAX.
AUTH_RATE_LOGIN_WINDOW_MS=60000
AUTH_RATE_LOGIN_SOURCE_MAX=30
AUTH_RATE_LOGIN_IDENTITY_MAX=10
# Explicit reset-delivery adapter; no console credential fallback.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@example.invalid
# Manual migration CLI only; it never reads application .env or starts at boot:
# AUTH_MIGRATION_MONGO_URI=<authorized nonproduction Mongo database>
# PG_MIGRATION_URL=<separate named mediid_migrator credential>
