# Optional isolated auth foundation. Existing /api/auth does not use these settings.
# Supply two separate PEM values through the environment/secrets, never committed key files.
# Multi-line PEM values or escaped newline sequences are supported. No real keys are included.
AUTH_JWT_PRIVATE_KEY=REPLACE_WITH_PRIVATE_RSA_PEM_IN_SECRET_STORAGE
AUTH_JWT_PUBLIC_KEY=REPLACE_WITH_PUBLIC_RSA_PEM
AUTH_JWT_KEY_ID=development-single-key
AUTH_JWT_ISSUER=mediid-auth-development
AUTH_JWT_AUDIENCE=mediid-api-development
AUTH_JWT_TTL_SECONDS=900
AUTH_BCRYPT_COST=12
AUTH_RESET_TTL_SECONDS=900
