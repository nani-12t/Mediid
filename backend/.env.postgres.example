# Copy to .env.postgres.local for local developer tools. Never commit the local file.
# Keep only runtime credentials in deployed application environments.
NODE_ENV=development
PG_RUNTIME_URL=postgresql://mediid_runtime:replace_with_runtime_password@127.0.0.1:5432/mediid_development?schema=public&sslmode=disable
PG_MIGRATION_URL=postgresql://mediid_migrator:replace_with_migration_password@127.0.0.1:5432/mediid_development?schema=public&sslmode=disable
PG_READONLY_URL=postgresql://mediid_diagnostics:replace_with_diagnostics_password@127.0.0.1:5432/mediid_development?schema=public&sslmode=disable
PG_POOL_SIZE=4
PG_CONNECT_TIMEOUT_SECONDS=3
PG_POOL_TIMEOUT_SECONDS=5
PG_QUERY_TIMEOUT_SECONDS=10
PG_CONNECT_ATTEMPTS=3
PG_RETRY_DELAY_MS=250
# Production URLs must use sslmode=require&sslaccept=strict plus the appropriate CA.
