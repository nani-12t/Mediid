PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/mediid
CLIENT_URL=http://localhost:3000

# Explicit authentication selection; also supply RSA settings from .env.auth.example.
# This example retains legacy Mongo authentication. No automatic PostgreSQL cutover.
AUTH_BACKEND=legacy

# Explicit provider domain selection; postgres requires AUTH_BACKEND=postgres.
ORGANIZATION_BACKEND=legacy

# Explicit patient selection; postgres requires AUTH_BACKEND=postgres and ORGANIZATION_BACKEND=postgres.
PATIENT_BACKEND=legacy
# PostgreSQL patient mode requires a private random key of at least 32 bytes (never commit it).
# PATIENT_AADHAAR_HASH_KEY=
# PATIENT_SCAN_WINDOW_MS=60000
# PATIENT_SCAN_SOURCE_MAX=60
# PATIENT_SCAN_IDENTITY_MAX=120

# ─── Twilio SMS + WhatsApp ────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (for SMS) — must be in E.164 format
TWILIO_PHONE_NUMBER=+91xxxxxxxxxx

# For WhatsApp: use the Twilio Sandbox number during dev,
# or your approved WhatsApp Business number in production
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── File Storage ─────────────────────────────────────────────────────
STORAGE_TYPE=local
AWS_BUCKET_NAME=mediid-reports
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
