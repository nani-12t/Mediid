{
  "name": "mediid-backend",
  "version": "1.0.0",
  "description": "MediID Digital Medical ID System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:validate": "node scripts/prisma-schema.cjs validate",
    "prisma:generate": "node scripts/prisma-schema.cjs generate",
    "test:schema": "node tests/schema-hardening.mjs",
    "test:legacy": "node --test tests/db-config.test.cjs tests/listen.test.cjs tests/mongo-regression.test.cjs",
    "test:review": "node tests/phase131-review.mjs",
    "test:review:reproduce": "node tests/phase131-review.mjs --reproduce",
    "test:review:native": "node tests/phase131-native.mjs",
    "test:infra:unit": "node --test tests/infrastructure-unit.test.cjs",
    "test:infra": "node tests/phase21-infrastructure.mjs",
    "test:native:exact": "node tests/phase21-native-gate.mjs",
    "db:check": "node src/infrastructure/postgres/cli.js check",
    "db:diagnostics": "node src/infrastructure/postgres/cli.js readonly",
    "db:migrate:deploy": "node scripts/prisma.cjs deploy",
    "db:migrate:status": "node scripts/prisma.cjs status",
    "test:auth:unit": "node --test tests/auth-unit.test.cjs tests/auth-hardening-unit.test.cjs",
    "test:auth": "node tests/phase22a-auth.mjs",
    "check:js": "node scripts/check-js.cjs",
    "test:auth:sessions": "node tests/phase22b-sessions.mjs",
    "test:auth:redis": "node tests/phase22b-redis.mjs",
    "test:auth:provisioning": "node tests/phase22b-provisioning.mjs",
    "test:auth:migration": "node tests/phase22b-migration.mjs",
    "test:auth:http": "node tests/phase22b-http.mjs",
    "auth:migrate": "node scripts/migrate-auth.cjs"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.5",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "twilio": "^5.3.0",
    "uuid": "^9.0.0",
    "uuidv7": "1.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "mongodb-memory-server": "10.2.3",
    "nodemon": "^3.0.2",
    "pg": "8.16.3",
    "prisma": "6.19.3"
  }
}
