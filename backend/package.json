{
  "name": "mediid-backend",
  "version": "1.0.0",
  "description": "MediID Digital Medical ID System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "test:schema": "node tests/schema-hardening.mjs",
    "test:legacy": "node --test tests/db-config.test.cjs tests/listen.test.cjs tests/mongo-regression.test.cjs",
    "test:review": "node tests/phase131-review.mjs",
    "test:review:reproduce": "node tests/phase131-review.mjs --reproduce",
    "test:review:native": "node tests/phase131-native.mjs"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.5",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "twilio": "^5.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "^25.4.0",
    "mongodb-memory-server": "10.2.3",
    "nodemon": "^3.0.2",
    "pg": "8.16.3",
    "prisma": "6.19.3"
  }
}
