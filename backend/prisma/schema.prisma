// MEDIID - Target PostgreSQL Data Model (Prisma Schema Design)
// Schema Version: Phase 1.3 — Final Appointment Architecture Freeze (2026-10-09)
// Frozen for Phase 2 Implementation — DO NOT modify without ADR approval

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────
// 1. IDENTITY, USERS & AUTHENTICATION
// ─────────────────────────────────────────────────────────────

enum UserRole {
  patient
  hospital_admin
  doctor
  buyer
  pharmacy
  support_agent
}

model User {
  id                     String    @id @db.Uuid // Migrated: UUIDv5, New: UUIDv7
  email                  String?   @unique @db.VarChar(255)
  uid                    String?   @unique @db.VarChar(64)
  passwordHash           String    @map("password_hash") @db.VarChar(255)
  role                   UserRole
  isActive               Boolean   @default(true) @map("is_active")
  resetPasswordToken     String?   @map("reset_password_token") @db.VarChar(32)
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at") @db.Timestamptz(6)
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  patient               Patient?
  doctorProfile         Doctor?
  hospitalAdmin         Hospital?               @relation("HospitalAdminUser")
  pharmacyUser          Pharmacy?               @relation("PharmacyAdminUser")
  buyerProfile          Buyer?
  uploadedDocuments     MedicalDocument[]       @relation("DocumentUploadedBy")
  clinicalNotesAuthored ClinicalNote[]          @relation("ClinicalNoteAuthor")
  handledAppointments              Appointment[]              @relation("AppointmentHandledBy")
  handledHospitalAppointments      HospitalAppointment[]      @relation("HospitalAppointmentHandledBy")
  handledPrivateClinicAppointments PrivateClinicAppointment[] @relation("PrivateClinicAppointmentHandledBy")
  bookedHospitalAppointments       HospitalAppointment[]      @relation("HospitalAppointmentBookedBy")
  bookedPrivateClinicAppointments  PrivateClinicAppointment[] @relation("PrivateClinicAppointmentBookedBy")
  accessLogsTriggered              AccessLog[]                @relation("AccessLogTriggeredBy")
  breakGlassEvents      BreakGlassEvent[]       @relation("BreakGlassTriggeredBy")
  sentMessages          MarketplaceMessage[]    @relation("MessageSender")
  receivedMessages      MarketplaceMessage[]    @relation("MessageReceiver")

  @@index([email])
  @@index([uid])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// 2. HEALTHCARE ORGANIZATIONS & HOSPITALS
// ─────────────────────────────────────────────────────────────

enum OrganizationType {
  government
  private
  trust
  clinic
}

model Hospital {
  id                 String           @id @db.Uuid
  userId             String           @unique @map("user_id") @db.Uuid
  uid                String           @unique @db.VarChar(32) // Public ID: HID-XXXXXXXX
  name               String           @db.VarChar(255)
  registrationNumber String?          @map("registration_number") @db.VarChar(128)
  type               OrganizationType @default(private)
  street             String?          @db.VarChar(255)
  city               String?          @db.VarChar(100)
  state              String?          @db.VarChar(100)
  pincode            String?          @db.VarChar(20)
  country            String?          @default("India") @db.VarChar(100)
  latitude           Decimal?         @db.Decimal(9, 6)
  longitude          Decimal?         @db.Decimal(9, 6)
  contactPhone       String?          @map("contact_phone") @db.VarChar(32)
  contactEmail       String?          @map("contact_email") @db.VarChar(255)
  website            String?          @db.VarChar(255)
  emergencyPhone     String?          @map("emergency_phone") @db.VarChar(32)
  specialties        String[]
  facilities         String[]
  operatingHours     Json?            @map("operating_hours")
  totalBeds          Int?             @default(0) @map("total_beds")
  icuBeds            Int?             @default(0) @map("icu_beds")
  logoUrl            String?          @map("logo_url")
  photos             String[]
  ratingAverage      Decimal          @default(0.00) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int              @default(0) @map("rating_count")
  doctorSequence     Int              @default(0) @map("doctor_sequence")
  staffSequence      Int              @default(0) @map("staff_sequence")
  isVerified         Boolean          @default(false) @map("is_verified")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user                   User                         @relation("HospitalAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  primaryDoctors         Doctor[]                     @relation("PrimaryHospitalDoctors")
  memberships            DoctorHospitalMembership[]
  staffMembers           HospitalStaff[]
  pharmacies             Pharmacy[]
  appointments                    Appointment[]
  hospitalAppointments            HospitalAppointment[]
  schedulingRules                 HospitalSchedulingRule[]
  recurringAvailabilityTemplates  RecurringAvailabilityTemplate[]
  scheduleOverrides               ScheduleOverride[]
  materializedSlots               MaterializedAppointmentSlot[]
  encounters                      Encounter[]
  prescriptions                   Prescription[]
  doctorSlots                     DoctorSlot[]
  trustedByPatients               PatientTrustedHospital[]
  accessGrants                    AccessGrant[]
  breakGlassEvents                BreakGlassEvent[]

  @@index([city])
  @@index([isActive])
  @@map("hospitals")
}

model Pharmacy {
  id         String   @id @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  name       String   @default("Hospital Pharmacy") @db.VarChar(255)
  phone      String?  @db.VarChar(32)
  email      String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User               @relation("PharmacyAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  hospital  Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  dispenses PharmacyDispense[]

  @@index([hospitalId])
  @@map("pharmacies")
}

enum StaffRole {
  nurse
  receptionist
  lab_technician
  pharmacist
  ward_boy
  security
  administrator
  radiologist
  physiotherapist
  other
}

model HospitalStaff {
  id             String    @id @db.Uuid
  hospitalId     String    @map("hospital_id") @db.Uuid
  uid            String    @unique @db.VarChar(64) // e.g. HID-XXXXXXXX-STF-0001
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  role           StaffRole
  department     String?   @db.VarChar(100)
  employeeId     String?   @map("employee_id") @db.VarChar(64)
  qualifications String[]
  experience     Int?
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(255)
  photoUrl       String?   @map("photo_url")
  dateOfJoining  DateTime? @map("date_of_joining") @db.Date
  shift          String?   @default("morning") @db.VarChar(20)
  status         String?   @default("active") @db.VarChar(20)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("hospital_memberships")
}

// ─────────────────────────────────────────────────────────────
// 3. DOCTORS, PRACTITIONERS & PRACTICE MEMBERSHIPS
// ─────────────────────────────────────────────────────────────

enum DoctorStatus {
  available
  busy
  on_leave
  offline
}

model Doctor {
  id                 String       @id @db.Uuid
  userId             String?      @unique @map("user_id") @db.Uuid
  primaryHospitalId  String?      @map("primary_hospital_id") @db.Uuid // Nullable for independent private clinic doctors
  uid                String       @unique @db.VarChar(64) // e.g. HID-XXXXXXXX-DOC-0001 or DOC-XXXXXXXX
  firstName          String       @map("first_name") @db.VarChar(100)
  lastName           String       @map("last_name") @db.VarChar(100)
  specialization     String       @db.VarChar(150)
  subSpecialties     String[]     @map("sub_specialties")
  qualifications     String[]
  experienceYears    Int?         @map("experience_years")
  registrationNumber String?      @map("registration_number") @db.VarChar(100)
  phone              String?      @db.VarChar(32)
  email              String?      @db.VarChar(255)
  photoUrl           String?      @map("photo_url")
  consultationFee    Decimal      @default(500.00) @map("consultation_fee") @db.Decimal(10, 2)
  expertise          String[]
  languages          String[]
  ratingAverage      Decimal      @default(0.00) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int          @default(0) @map("rating_count")
  status             DoctorStatus @default(available)
  isPrivatePractice  Boolean      @default(false) @map("is_private_practice")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryHospital      Hospital?                  @relation("PrimaryHospitalDoctors", fields: [primaryHospitalId], references: [id], onDelete: SetNull)
  hospitalMemberships  DoctorHospitalMembership[]
  appointments                    Appointment[]
  hospitalAppointments            HospitalAppointment[]
  privateClinicAppointments       PrivateClinicAppointment[]
  clinicSchedulingPolicy          DoctorClinicPolicy?
  recurringAvailabilityTemplates  RecurringAvailabilityTemplate[]
  scheduleOverrides               ScheduleOverride[]
  materializedSlots               MaterializedAppointmentSlot[]
  encounters                      Encounter[]
  prescriptions                   Prescription[]
  doctorSlots                     DoctorSlot[]
  consultationSessions            ConsultationSession[]
  trustedByPatients               PatientTrustedDoctor[]
  accessLogsTargeted              AccessLog[]
  accessGrants                    AccessGrant[]
  breakGlassEvents                BreakGlassEvent[]

  @@index([specialization])
  @@index([primaryHospitalId])
  @@map("doctors")
}

model DoctorHospitalMembership {
  id         String   @id @db.Uuid
  doctorId   String   @map("doctor_id") @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  roleTitle  String?  @default("Attending Physician") @map("role_title") @db.VarChar(100)
  isPrimary  Boolean  @default(false) @map("is_primary")
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([doctorId, hospitalId])
  @@map("doctor_hospital_memberships")
}

enum SlotScheduleType {
  date
  day
}

model DoctorSlot {
  id           String           @id @db.Uuid
  doctorId     String           @map("doctor_id") @db.Uuid
  // hospitalId is INTENTIONALLY nullable.
  // Rationale (Phase 1.2): A DoctorSlot defines a doctor's availability schedule.
  // Private-practice doctors who have not yet been associated with any clinic/hospital
  // organization record may define slots at the practitioner level before a clinic
  // organization record is created. hospitalId becomes non-null once the doctor is
  // affiliated with an organization (Hospital.type = clinic | private | government | trust).
  // Appointments referencing a slot MUST always carry a non-null hospitalId — the
  // organizational context is mandatory on Appointment, not on the slot template itself.
  hospitalId   String?          @map("hospital_id") @db.Uuid
  scheduleType SlotScheduleType @map("schedule_type")
  specificDate DateTime?        @map("specific_date") @db.Date
  dayOfWeek    String?          @map("day_of_week") @db.VarChar(16)
  timeSlots    String[]         @map("time_slots")
  maxBookings  Int              @default(1) @map("max_bookings")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([doctorId, scheduleType, specificDate, dayOfWeek])
  @@map("doctor_slots")
}

// ─────────────────────────────────────────────────────────────
// 3b. MATERIALIZED APPOINTMENT SLOTS & ADVANCED SCHEDULING (Phase 1.3)
// ─────────────────────────────────────────────────────────────

enum SlotChannel {
  ONLINE
  OFFLINE
  FLEXIBLE
}

enum SlotState {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
  EXPIRED
}

enum HospitalConfirmationMode {
  DEPOSIT
  TIME_BASED
  MANUAL
}

enum OverrideType {
  LEAVE
  EMERGENCY_BLOCK
  CUSTOM_HOURS
  HOLIDAY
}

enum BookingChannel {
  ONLINE_APP
  WALK_IN
  PHONE
  SUPPORT_ASSISTED
}

enum PaymentHoldStatus {
  NONE
  PENDING
  HELD
  PAID
  RELEASED
  EXPIRED
}

enum CancellationInitiator {
  PATIENT
  DOCTOR
  HOSPITAL_FRONT_DESK
  SUPPORT_AGENT
  SYSTEM_AUTO_EXPIRE
}

enum RescheduleInitiator {
  PATIENT
  DOCTOR
  HOSPITAL_FRONT_DESK
  SUPPORT_AGENT
}

enum RefundStatus {
  NOT_APPLICABLE
  PENDING
  COMPLETED
  FAILED
  REJECTED
  TRANSFER_CREDIT_OFFERED
}

// Hospital front-desk scheduling configuration
model HospitalSchedulingRule {
  id                        String                   @id @db.Uuid
  hospitalId                String                   @unique @map("hospital_id") @db.Uuid
  confirmationMode          HospitalConfirmationMode @default(TIME_BASED) @map("confirmation_mode")
  depositRequired           Boolean                  @default(false) @map("deposit_required")
  depositPercentage         Decimal                  @default(0.00) @map("deposit_percentage") @db.Decimal(5, 2)
  depositFixedAmount        Decimal?                 @map("deposit_fixed_amount") @db.Decimal(10, 2)
  paymentHoldWindowMinutes  Int                      @default(60) @map("payment_hold_window_minutes")
  safetyCutoffMinutes       Int                      @default(10) @map("safety_cutoff_minutes")
  fastConfirmWindowMinutes  Int                      @default(5) @map("fast_confirm_window_minutes")
  cancellationCutoffHours   Int                      @default(2) @map("cancellation_cutoff_hours")
  rescheduleCutoffHours     Int                      @default(2) @map("reschedule_cutoff_hours")
  maxRescheduleCount        Int                      @default(2) @map("max_reschedule_count")
  refundPolicyNotes         String?                  @map("refund_policy_notes")
  allowWalkIns              Boolean                  @default(true) @map("allow_walk_ins")
  allowPhoneBookings        Boolean                  @default(true) @map("allow_phone_bookings")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("hospital_scheduling_rules")
}

// Private clinic doctor-owned scheduling configuration
// Note: Doctor-owned strictly — NO receptionist or front desk role
model DoctorClinicPolicy {
  id                        String   @id @db.Uuid
  doctorId                  String   @unique @map("doctor_id") @db.Uuid
  depositPercentage         Decimal  @default(50.00) @map("deposit_percentage") @db.Decimal(5, 2) // Required 50% online deposit
  paymentHoldWindowMinutes  Int      @default(60) @map("payment_hold_window_minutes")
  safetyCutoffMinutes       Int      @default(10) @map("safety_cutoff_minutes")
  fastConfirmWindowMinutes  Int      @default(5) @map("fast_confirm_window_minutes")
  cancellationCutoffHours   Int      @default(4) @map("cancellation_cutoff_hours")
  rescheduleCutoffHours     Int      @default(4) @map("reschedule_cutoff_hours")
  maxRescheduleCount        Int      @default(1) @map("max_reschedule_count")
  noShowFeeDeduction        Decimal  @default(100.00) @map("no_show_fee_deduction") @db.Decimal(5, 2) // % deducted if patient no-show
  refundPolicyNotes         String?  @map("refund_policy_notes")
  allowPhoneBookings        Boolean  @default(true) @map("allow_phone_bookings")
  allowWalkIns              Boolean  @default(true) @map("allow_walk_ins")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_clinic_policies")
}

// Recurring availability pattern (e.g. Every Monday 09:00 - 13:00)
model RecurringAvailabilityTemplate {
  id             String      @id @db.Uuid
  doctorId       String      @map("doctor_id") @db.Uuid
  hospitalId     String?     @map("hospital_id") @db.Uuid // Nullable for independent private clinic
  dayOfWeek      String      @map("day_of_week") @db.VarChar(16) // MONDAY, TUESDAY, etc.
  startTime      String      @map("start_time") @db.VarChar(10) // "09:00"
  endTime        String      @map("end_time") @db.VarChar(10) // "13:00"
  slotDuration   Int         @default(15) @map("slot_duration") // Duration in minutes
  channel        SlotChannel @default(FLEXIBLE)
  capacityPerSlot Int        @default(1) @map("capacity_per_slot")
  timezone       String      @default("Asia/Kolkata") @db.VarChar(64)
  effectiveFrom  DateTime    @map("effective_from") @db.Date
  effectiveUntil DateTime?   @map("effective_until") @db.Date
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
  @@index([hospitalId])
  @@map("recurring_availability_templates")
}

// Schedule override (leaves, emergency blocks, custom hours, holidays)
model ScheduleOverride {
  id           String       @id @db.Uuid
  doctorId     String       @map("doctor_id") @db.Uuid
  hospitalId   String?      @map("hospital_id") @db.Uuid // Nullable for clinic
  overrideType OverrideType @map("override_type")
  startDateTime DateTime    @map("start_date_time") @db.Timestamptz(6)
  endDateTime   DateTime    @map("end_date_time") @db.Timestamptz(6)
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDateTime, endDateTime])
  @@map("schedule_overrides")
}

// Materialized individual appointment slots
// Prevents cross-facility doctor conflicts and enforces transactional reservation
model MaterializedAppointmentSlot {
  id                    String      @id @db.Uuid
  doctorId              String      @map("doctor_id") @db.Uuid
  hospitalId            String?     @map("hospital_id") @db.Uuid // Org context; null for independent private practice
  slotStart             DateTime    @map("slot_start") @db.Timestamptz(6)
  slotEnd               DateTime    @map("slot_end") @db.Timestamptz(6)
  channel               SlotChannel @default(FLEXIBLE)
  state                 SlotState   @default(AVAILABLE)
  holdExpiresAt         DateTime?   @map("hold_expires_at") @db.Timestamptz(6)
  heldByUserId          String?     @map("held_by_user_id") @db.Uuid
  version               Int         @default(0) // Optimistic concurrency version
  reopenedCount         Int         @default(0) @map("reopened_count")
  lastReopenedAt        DateTime?   @map("last_reopened_at") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctor                     Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital                   Hospital?                   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalAppointments       HospitalAppointment[]
  privateClinicAppointments  PrivateClinicAppointment[]

  // Doctor uniqueness invariant: a doctor can never have overlapping slots
  // across any hospital or clinic context
  @@unique([doctorId, slotStart])
  @@index([doctorId, slotStart, slotEnd])
  @@index([hospitalId, slotStart])
  @@index([state, slotStart])
  @@map("materialized_appointment_slots")
}

// ─────────────────────────────────────────────────────────────
// 4. PATIENT RECORD, DEMOGRAPHICS & EMERGENCY PROFILE
// ─────────────────────────────────────────────────────────────

enum Gender {
  male
  female
  other
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

model Patient {
  id                       String      @id @db.Uuid
  userId                   String      @unique @map("user_id") @db.Uuid
  uid                      String      @unique @db.VarChar(32) // Public ID: MID-XXXXXXXX
  firstName                String      @map("first_name") @db.VarChar(100)
  lastName                 String      @map("last_name") @db.VarChar(100)
  dateOfBirth              DateTime?   @map("date_of_birth") @db.Date
  gender                   Gender?
  phone                    String?     @db.VarChar(32)
  profilePhotoUrl          String?     @map("profile_photo_url")
  street                   String?     @db.VarChar(255)
  city                     String?     @db.VarChar(100)
  state                    String?     @db.VarChar(100)
  pincode                  String?     @db.VarChar(20)
  country                  String?     @default("India") @db.VarChar(100)
  bloodGroup               BloodGroup? @map("blood_group")
  aadhaarHash              String?     @map("aadhaar_hash") @db.VarChar(128)
  organDonor               Boolean     @default(false) @map("organ_donor")
  emergencyContactName     String?     @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone    String?     @map("emergency_contact_phone") @db.VarChar(32)
  emergencyContactRelation String?     @map("emergency_contact_relation") @db.VarChar(50)
  qrActive                 Boolean     @default(true) @map("qr_active")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefits             PatientBenefit[]
  trustedDoctors            PatientTrustedDoctor[]
  trustedHospitals          PatientTrustedHospital[]
  appointments              Appointment[]
  hospitalAppointments      HospitalAppointment[]
  privateClinicAppointments PrivateClinicAppointment[]
  encounters                Encounter[]
  conditions           Condition[]
  allergies            Allergy[]
  prescriptions        Prescription[]
  documents            MedicalDocument[]
  bills                BillingRecord[]
  bloodRequests        BloodRequest[]
  medicineOrders       MedicineOrder[]
  notifications        Notification[]
  consultationSessions ConsultationSession[]
  accessLogs           AccessLog[]
  consents             Consent[]
  accessGrants         AccessGrant[]
  breakGlassEvents     BreakGlassEvent[]
  submissions          DatasetSubmission[]
  datasetConsents      DatasetConsent[]

  @@index([uid])
  @@index([phone])
  @@map("patients")
}

model PatientBenefit {
  id              String    @id @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  source          String    @db.VarChar(32) // government, employer, personal
  type            String    @default("other_govt") @db.VarChar(64)
  schemeName      String?   @map("scheme_name") @db.VarChar(255)
  cardNumber      String?   @map("card_number") @db.VarChar(128)
  policyNumber    String?   @map("policy_number") @db.VarChar(128)
  beneficiaryName String?   @map("beneficiary_name") @db.VarChar(255)
  employerName    String?   @map("employer_name") @db.VarChar(255)
  employeeId      String?   @map("employee_id") @db.VarChar(64)
  designation     String?   @db.VarChar(100)
  insurerName     String?   @map("insurer_name") @db.VarChar(255)
  tpaName         String?   @map("tpa_name") @db.VarChar(255)
  tpaPhone        String?   @map("tpa_phone") @db.VarChar(32)
  coverageAmount  Decimal?  @map("coverage_amount") @db.Decimal(12, 2)
  roomRentLimit   Decimal?  @map("room_rent_limit") @db.Decimal(10, 2)
  familyCovered   Boolean   @default(false) @map("family_covered")
  familyMembers   String[]  @map("family_members")
  validFrom       DateTime? @map("valid_from") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  hospitalNetwork String?   @map("hospital_network")
  claimProcess    String?   @map("claim_process")
  helplineNumber  String?   @map("helpline_number") @db.VarChar(32)
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_benefits")
}

model PatientTrustedDoctor {
  patientId String @map("patient_id") @db.Uuid
  doctorId  String @map("doctor_id") @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([patientId, doctorId])
  @@map("patient_trusted_doctors")
}

model PatientTrustedHospital {
  patientId  String @map("patient_id") @db.Uuid
  hospitalId String @map("hospital_id") @db.Uuid

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([patientId, hospitalId])
  @@map("patient_trusted_hospitals")
}

// ─────────────────────────────────────────────────────────────
// 5. APPOINTMENTS & CONSULTATION ACCESS SESSIONS
// ─────────────────────────────────────────────────────────────

enum AppointmentStatus {
  pending
  reminder_sent
  confirmed
  checked_in
  completed
  expired
  cancelled
  rescheduled
}

// ORGANIZATIONAL CONTEXT INVARIANT (Phase 1.2):
// Every Appointment MUST belong to an organization (Hospital record).
// hospitalId is NON-NULLABLE on Appointment by design.
//
// For private clinic doctors, the clinic is represented as a Hospital record
// with type = clinic. This guarantees that every clinical appointment carries
// an organizational context — there are no organization-less appointments.
//
// Examples:
//   Patient -> Apollo Hospital (type=private)    -> Cardiologist
//   Patient -> Dr Rao Private Clinic (type=clinic) -> Dr Rao
//
// For a truly independent private-practice doctor not yet affiliated with any
// organization, a clinic Hospital record must be created first.
model Appointment {
  id                     String            @id @db.Uuid
  patientId              String            @map("patient_id") @db.Uuid
  doctorId               String            @map("doctor_id") @db.Uuid
  // MANDATORY: Every appointment must have an organizational context.
  // For private clinics, this references a Hospital record with type=clinic.
  hospitalId             String            @map("hospital_id") @db.Uuid
  appointmentDate        DateTime          @map("appointment_date") @db.Date
  timeSlot               String            @map("time_slot") @db.VarChar(32)
  status                 AppointmentStatus @default(pending)
  type                   String            @default("consultation") @db.VarChar(32)
  bookingMethod          String            @default("app") @map("booking_method") @db.VarChar(32)
  preferredContactMethod String            @default("whatsapp") @map("preferred_contact_method") @db.VarChar(32)
  contactPhone           String?           @map("contact_phone") @db.VarChar(32)
  symptoms               String?
  notes                  String?
  confirmToken           String            @unique @default(uuid()) @map("confirm_token") @db.VarChar(64)
  confirmTokenUsed       Boolean           @default(false) @map("confirm_token_used")
  patientConfirmedAt     DateTime?         @map("patient_confirmed_at") @db.Timestamptz(6)
  handledByUserId        String?           @map("handled_by_user_id") @db.Uuid
  staffNotes             String?           @map("staff_notes")
  confirmedAt            DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  confirmationMethod     String?           @map("confirmation_method") @db.VarChar(32)
  billAmount             Decimal           @default(500.00) @map("bill_amount") @db.Decimal(10, 2)
  billStatus             String            @default("pending") @map("bill_status") @db.VarChar(32)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor               Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital             Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  handledByUser        User?                  @relation("AppointmentHandledBy", fields: [handledByUserId], references: [id])
  encounters           Encounter[]
  consultationSessions ConsultationSession[]
  accessLogs           AccessLog[]
  notifications        Notification[]
  billingRecords       BillingRecord[]

  @@index([patientId])
  @@index([doctorId, appointmentDate])
  @@index([hospitalId])
  @@map("appointments")
}

model ConsultationSession {
  id                           String                    @id @db.Uuid
  patientId                    String                    @map("patient_id") @db.Uuid
  doctorId                     String                    @map("doctor_id") @db.Uuid
  appointmentId                String?                   @map("appointment_id") @db.Uuid // Nullable to support domain split
  hospitalAppointmentId         String?                   @map("hospital_appointment_id") @db.Uuid
  privateClinicAppointmentId    String?                   @map("private_clinic_appointment_id") @db.Uuid
  token                        String                    @unique @db.VarChar(128)
  status                       String                    @default("active") @db.VarChar(32) // active, completed, expired
  expiresAt                    DateTime                  @map("expires_at") @db.Timestamptz(6)
  createdAt                    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt                  DateTime?                 @map("completed_at") @db.Timestamptz(6)

  patient                  Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                   Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment              Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hospitalAppointment      HospitalAppointment?      @relation(fields: [hospitalAppointmentId], references: [id], onDelete: Cascade)
  privateClinicAppointment PrivateClinicAppointment? @relation(fields: [privateClinicAppointmentId], references: [id], onDelete: Cascade)
  accessLogs               AccessLog[]

  @@index([patientId, doctorId, status])
  @@map("consultation_sessions")
}

// ─────────────────────────────────────────────────────────────
// 5b. DOMAIN-SPECIFIC SCHEDULING: HOSPITAL & PRIVATE CLINIC
// ─────────────────────────────────────────────────────────────

// Hospital Appointment: Managed by Front Desk, supports DEPOSIT, TIME_BASED, MANUAL
model HospitalAppointment {
  id                     String            @id @db.Uuid
  patientId              String            @map("patient_id") @db.Uuid
  doctorId               String            @map("doctor_id") @db.Uuid
  hospitalId             String            @map("hospital_id") @db.Uuid
  slotId                 String?           @map("slot_id") @db.Uuid
  bookingChannel         BookingChannel    @default(ONLINE_APP) @map("booking_channel")
  status                 AppointmentStatus @default(pending)
  confirmationMode       HospitalConfirmationMode @default(TIME_BASED) @map("confirmation_mode")
  appointmentDate        DateTime          @map("appointment_date") @db.Date
  timeSlot               String            @map("time_slot") @db.VarChar(32)
  slotStartTime          DateTime          @map("slot_start_time") @db.Timestamptz(6)
  slotEndTime            DateTime          @map("slot_end_time") @db.Timestamptz(6)
  
  // Payment Hold & Deadlines
  holdExpiresAt          DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  paymentHoldStatus      PaymentHoldStatus @default(NONE) @map("payment_hold_status")
  depositRequired        Boolean           @default(false) @map("deposit_required")
  depositAmount          Decimal           @default(0.00) @map("deposit_amount") @db.Decimal(10, 2)
  totalFee               Decimal           @default(500.00) @map("total_fee") @db.Decimal(10, 2)
  amountPaid             Decimal           @default(0.00) @map("amount_paid") @db.Decimal(10, 2)
  paymentIdempotencyKey  String?           @unique @map("payment_idempotency_key") @db.VarChar(128)

  // Policy snapshot at booking
  policySnapshot         Json?             @map("policy_snapshot")

  // Rescheduling & Cancellation tracking
  rescheduleCount        Int               @default(0) @map("reschedule_count")
  cancellationInitiator  CancellationInitiator? @map("cancellation_initiator")
  cancellationReason     String?           @map("cancellation_reason")
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  refundStatus           RefundStatus      @default(NOT_APPLICABLE) @map("refund_status")
  refundAmount           Decimal           @default(0.00) @map("refund_amount") @db.Decimal(10, 2)
  refundTransactionRef   String?           @map("refund_transaction_ref") @db.VarChar(128)
  noShowRecorded         Boolean           @default(false) @map("no_show_recorded")

  // Support / Front-desk handling & auditing
  bookedByUserId         String?           @map("booked_by_user_id") @db.Uuid
  handledByUserId        String?           @map("handled_by_user_id") @db.Uuid
  supportNotes           String?           @map("support_notes")
  staffNotes             String?           @map("staff_notes")

  // Notifications & tokens
  confirmToken           String            @unique @default(uuid()) @map("confirm_token") @db.VarChar(64)
  confirmTokenUsed       Boolean           @default(false) @map("confirm_token_used")
  patientConfirmedAt     DateTime?         @map("patient_confirmed_at") @db.Timestamptz(6)
  confirmedAt            DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  confirmationMethod     String?           @map("confirmation_method") @db.VarChar(32)

  // Patient metadata
  symptoms               String?
  notes                  String?
  contactPhone           String?           @map("contact_phone") @db.VarChar(32)
  preferredContactMethod String            @default("whatsapp") @map("preferred_contact_method") @db.VarChar(32)

  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient              Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor               Doctor                       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital             Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  slot                 MaterializedAppointmentSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  bookedByUser         User?                        @relation("HospitalAppointmentBookedBy", fields: [bookedByUserId], references: [id])
  handledByUser        User?                        @relation("HospitalAppointmentHandledBy", fields: [handledByUserId], references: [id])
  encounters           Encounter[]
  consultationSessions ConsultationSession[]
  billingRecords       BillingRecord[]
  notifications        Notification[]
  accessLogs           AccessLog[]

  @@index([patientId])
  @@index([doctorId, appointmentDate])
  @@index([hospitalId, appointmentDate])
  @@index([status, holdExpiresAt])
  @@map("hospital_appointments")
}

// Private Clinic Appointment: Doctor-owned strictly (NO receptionist role)
// Online bookings require mandatory 50% deposit
model PrivateClinicAppointment {
  id                     String            @id @db.Uuid
  patientId              String            @map("patient_id") @db.Uuid
  doctorId               String            @map("doctor_id") @db.Uuid
  clinicHospitalId       String?           @map("clinic_hospital_id") @db.Uuid // Optional clinic org context
  slotId                 String?           @map("slot_id") @db.Uuid
  bookingChannel         BookingChannel    @default(ONLINE_APP) @map("booking_channel")
  status                 AppointmentStatus @default(pending)
  appointmentDate        DateTime          @map("appointment_date") @db.Date
  timeSlot               String            @map("time_slot") @db.VarChar(32)
  slotStartTime          DateTime          @map("slot_start_time") @db.Timestamptz(6)
  slotEndTime            DateTime          @map("slot_end_time") @db.Timestamptz(6)

  // Payment Hold & 50% Deposit Requirements
  holdExpiresAt          DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  paymentHoldStatus      PaymentHoldStatus @default(NONE) @map("payment_hold_status")
  depositPercentage      Decimal           @default(50.00) @map("deposit_percentage") @db.Decimal(5, 2)
  depositAmount          Decimal           @map("deposit_amount") @db.Decimal(10, 2)
  totalFee               Decimal           @default(500.00) @map("total_fee") @db.Decimal(10, 2)
  amountPaid             Decimal           @default(0.00) @map("amount_paid") @db.Decimal(10, 2)
  paymentIdempotencyKey  String?           @unique @map("payment_idempotency_key") @db.VarChar(128)

  // Doctor policy snapshot at booking
  policySnapshot         Json?             @map("policy_snapshot")

  // Rescheduling & Cancellation tracking
  rescheduleCount        Int               @default(0) @map("reschedule_count")
  cancellationInitiator  CancellationInitiator? @map("cancellation_initiator")
  cancellationReason     String?           @map("cancellation_reason")
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  refundStatus           RefundStatus      @default(NOT_APPLICABLE) @map("refund_status")
  refundAmount           Decimal           @default(0.00) @map("refund_amount") @db.Decimal(10, 2)
  refundTransactionRef   String?           @map("refund_transaction_ref") @db.VarChar(128)
  noShowRecorded         Boolean           @default(false) @map("no_show_recorded")

  // Support / Doctor handling & auditing
  bookedByUserId         String?           @map("booked_by_user_id") @db.Uuid
  handledByUserId        String?           @map("handled_by_user_id") @db.Uuid
  supportNotes           String?           @map("support_notes")
  doctorNotes            String?           @map("doctor_notes")

  // Notifications & tokens
  confirmToken           String            @unique @default(uuid()) @map("confirm_token") @db.VarChar(64)
  confirmTokenUsed       Boolean           @default(false) @map("confirm_token_used")
  patientConfirmedAt     DateTime?         @map("patient_confirmed_at") @db.Timestamptz(6)
  confirmedAt            DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  confirmationMethod     String?           @map("confirmation_method") @db.VarChar(32)

  // Patient metadata
  symptoms               String?
  notes                  String?
  contactPhone           String?           @map("contact_phone") @db.VarChar(32)
  preferredContactMethod String            @default("whatsapp") @map("preferred_contact_method") @db.VarChar(32)

  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient              Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor               Doctor                       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  slot                 MaterializedAppointmentSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  bookedByUser         User?                        @relation("PrivateClinicAppointmentBookedBy", fields: [bookedByUserId], references: [id])
  handledByUser        User?                        @relation("PrivateClinicAppointmentHandledBy", fields: [handledByUserId], references: [id])
  encounters           Encounter[]
  consultationSessions ConsultationSession[]
  billingRecords       BillingRecord[]
  notifications        Notification[]
  accessLogs           AccessLog[]

  @@index([patientId])
  @@index([doctorId, appointmentDate])
  @@index([status, holdExpiresAt])
  @@map("private_clinic_appointments")
}

// ─────────────────────────────────────────────────────────────
// 6. LONGITUDINAL EHR, CLINICAL ENCOUNTERS & OBSERVATIONS
// ─────────────────────────────────────────────────────────────

enum EncounterStatus {
  planned
  in_progress
  completed
  cancelled
}

enum EncounterType {
  ambulatory
  emergency
  inpatient
  virtual
}

model Encounter {
  id                         String          @id @db.Uuid
  appointmentId              String?         @map("appointment_id") @db.Uuid
  hospitalAppointmentId      String?         @map("hospital_appointment_id") @db.Uuid
  privateClinicAppointmentId String?         @map("private_clinic_appointment_id") @db.Uuid
  patientId                  String          @map("patient_id") @db.Uuid
  doctorId                   String          @map("doctor_id") @db.Uuid
  hospitalId                 String?         @map("hospital_id") @db.Uuid
  encounterType              EncounterType   @default(ambulatory) @map("encounter_type")
  status                     EncounterStatus @default(in_progress)
  startTime                  DateTime        @default(now()) @map("start_time") @db.Timestamptz(6)
  endTime                    DateTime?       @map("end_time") @db.Timestamptz(6)
  chiefComplaint             String?         @map("chief_complaint")
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment              Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  hospitalAppointment      HospitalAppointment?      @relation(fields: [hospitalAppointmentId], references: [id], onDelete: SetNull)
  privateClinicAppointment PrivateClinicAppointment? @relation(fields: [privateClinicAppointmentId], references: [id], onDelete: SetNull)
  patient                  Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                   Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital                 Hospital?                  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  vitals           Vital[]
  clinicalNotes    ClinicalNote[]
  conditions       Condition[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  imagingOrders    ImagingOrder[]
  medicalDocuments MedicalDocument[]

  @@index([patientId])
  @@index([doctorId])
  @@map("encounters")
}

model Vital {
  id                 String   @id @db.Uuid
  encounterId        String   @map("encounter_id") @db.Uuid
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  systolicBp         Int?     @map("systolic_bp")
  diastolicBp        Int?     @map("diastolic_bp")
  heartRate          Int?     @map("heart_rate")
  respiratoryRate    Int?     @map("respiratory_rate")
  temperatureCelsius Decimal? @map("temperature_celsius") @db.Decimal(4, 2)
  spo2Percentage     Int?     @map("spo2_percentage")
  weightKg           Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm           Decimal? @map("height_cm") @db.Decimal(5, 2)
  bmi                Decimal? @db.Decimal(4, 2)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("vitals")
}

model ClinicalNote {
  id          String   @id @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  noteType    String   @default("progress") @map("note_type") @db.VarChar(32) // progress, consultation, discharge, procedure
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  author    User      @relation("ClinicalNoteAuthor", fields: [authorId], references: [id])

  @@index([encounterId])
  @@map("clinical_notes")
}

model Condition {
  id                 String    @id @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  encounterId        String?   @map("encounter_id") @db.Uuid
  icd10Code          String?   @map("icd10_code") @db.VarChar(16)
  displayName        String    @map("display_name") @db.VarChar(255)
  clinicalStatus     String    @default("active") @map("clinical_status") @db.VarChar(32) // active, resolved
  verificationStatus String    @default("confirmed") @map("verification_status") @db.VarChar(32)
  diagnosedDate      DateTime? @map("diagnosed_date") @db.Date
  resolvedDate       DateTime? @map("resolved_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("conditions")
}

model Allergy {
  id        String   @id @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  substance String   @db.VarChar(255)
  reaction  String?
  severity  String?  @db.VarChar(32) // mild, moderate, severe, fatal
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("allergies")
}

// ─────────────────────────────────────────────────────────────
// 7. PRESCRIPTIONS & PHARMACY DISPENSING
// ─────────────────────────────────────────────────────────────

model Prescription {
  id          String   @id @db.Uuid
  encounterId String?  @map("encounter_id") @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  hospitalId  String?  @map("hospital_id") @db.Uuid
  notes       String?
  status      String   @default("active") @db.VarChar(32) // active, dispensed, cancelled
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  encounter Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital  Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  items     PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  medicationName String  @map("medication_name") @db.VarChar(255)
  dosage         String  @db.VarChar(100) // e.g. "650mg"
  form           String? @db.VarChar(50) // tablet, syrup, injection
  frequency      String? @db.VarChar(100) // 1-0-1 after food
  duration       String? @db.VarChar(50) // 5 days
  quantity       Int     @default(1)
  instructions   String?

  prescription Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  dispenses    PharmacyDispense[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

model PharmacyDispense {
  id                 String   @id @db.Uuid
  pharmacyId         String   @map("pharmacy_id") @db.Uuid
  prescriptionItemId String   @map("prescription_item_id") @db.Uuid
  quantityDispensed  Int      @map("quantity_dispensed")
  unitPrice          Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice         Decimal  @map("total_price") @db.Decimal(10, 2)
  dispensedAt        DateTime @default(now()) @map("dispensed_at") @db.Timestamptz(6)

  pharmacy         Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("pharmacy_dispenses")
}

// ─────────────────────────────────────────────────────────────
// 8. DIAGNOSTICS: LABS & IMAGING
// ─────────────────────────────────────────────────────────────

model LabOrder {
  id          String   @id @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  testName    String   @map("test_name") @db.VarChar(255)
  reason      String?
  status      String   @default("pending") @db.VarChar(32) // pending, completed, cancelled
  orderedAt   DateTime @default(now()) @map("ordered_at") @db.Timestamptz(6)

  encounter Encounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  results   LabResult[]

  @@index([encounterId])
  @@map("lab_orders")
}

model LabResult {
  id          String   @id @db.Uuid
  labOrderId  String   @map("lab_order_id") @db.Uuid
  metricName  String   @map("metric_name") @db.VarChar(255) // e.g. "Hemoglobin"
  value       String   @db.VarChar(100) // e.g. "14.2"
  unit        String?  @db.VarChar(50) // e.g. "g/dL"
  normalRange String?  @map("normal_range") @db.VarChar(100) // e.g. "13.0 - 17.0"
  flag        String?  @db.VarChar(32) // normal, low, high, critical
  resultDate  DateTime @default(now()) @map("result_date") @db.Timestamptz(6)

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([labOrderId])
