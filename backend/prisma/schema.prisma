// ─────────────────────────────────────────────────────────────
// 11. SECURITY, CONSENT, ACCESS GRANTS & AUDIT TRAILS
// ─────────────────────────────────────────────────────────────

enum ConsentStatus {
  active
  revoked
  expired
}

// CLINICAL CONSENT ONLY (Phase 1.2):
// This Consent model covers CLINICAL healthcare access exclusively.
// granteeType MUST be one of: doctor | hospital | clinic
// Purpose MUST be one of: clinical_care | second_opinion | treatment | referral
//
// Research / marketplace authorization is handled by a completely separate
// DatasetConsent model in the air-gapped marketplace domain below.
// Researchers and buyers NEVER appear in this model.
model Consent {
  id          String        @id @db.Uuid
  patientId   String        @map("patient_id") @db.Uuid
  // CLINICAL grantee types only: doctor | hospital | clinic
  // Researcher access is handled via DatasetConsent — NOT this model.
  granteeType String        @map("grantee_type") @db.VarChar(32)
  granteeId   String        @map("grantee_id") @db.VarChar(64) // UUID or UID of grantee
  scopes      String[]      // e.g. ["vitals", "prescriptions", "documents"]
  // Clinical purpose values: clinical_care | second_opinion | treatment | referral
  purpose     String?       @db.VarChar(100)
  status      ConsentStatus @default(active)
  validFrom   DateTime      @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?     @map("valid_until") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@map("consents")
}

model AccessGrant {
  id         String    @id @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  doctorId   String?   @map("doctor_id") @db.Uuid
  hospitalId String?   @map("hospital_id") @db.Uuid
  purpose    String    @db.VarChar(100)
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("access_grants")
}

model BreakGlassEvent {
  id              String   @id @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  triggeredById   String   @map("triggered_by_id") @db.Uuid
  doctorId        String?  @map("doctor_id") @db.Uuid
  hospitalId      String?  @map("hospital_id") @db.Uuid
  emergencyReason String   @map("emergency_reason")
  accessedAt      DateTime @default(now()) @map("accessed_at") @db.Timestamptz(6)

  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  triggeredBy User      @relation("BreakGlassTriggeredBy", fields: [triggeredById], references: [id])
  doctor      Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("break_glass_events")
}

model AccessLog {
  id            String   @id @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  doctorId      String?  @map("doctor_id") @db.Uuid
  appointmentId              String?                   @map("appointment_id") @db.Uuid
  hospitalAppointmentId      String?                   @map("hospital_appointment_id") @db.Uuid
  privateClinicAppointmentId String?                   @map("private_clinic_appointment_id") @db.Uuid
  accessedById               String                    @map("accessed_by_id") @db.Uuid
  sessionId                  String?                   @map("session_id") @db.Uuid
  action                     String                    @db.VarChar(100) // view_patient_profile, view_documents
  status                     String                    @db.VarChar(32) // allowed, denied
  reason                     String?
  accessedAt                 DateTime                  @default(now()) @map("accessed_at") @db.Timestamptz(6)

  patient                  Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                   Doctor?                    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointment              Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  hospitalAppointment      HospitalAppointment?      @relation(fields: [hospitalAppointmentId], references: [id], onDelete: SetNull)
  privateClinicAppointment PrivateClinicAppointment? @relation(fields: [privateClinicAppointmentId], references: [id], onDelete: SetNull)
  accessedBy               User                       @relation("AccessLogTriggeredBy", fields: [accessedById], references: [id])
  session                  ConsultationSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([patientId, accessedAt])
  @@map("access_logs")
}

// ─────────────────────────────────────────────────────────────
// 12. DATA MARKETPLACE & RESEARCH DOMAIN (AIR-GAPPED)
// ─────────────────────────────────────────────────────────────
//
// ISOLATION INVARIANT (Phase 1.2):
// Buyers and researchers have ZERO direct access to any clinical EHR table.
// The controlled data flow is:
//
//   ResearchRequirement
//         ↓
//   DatasetSubmission (patient voluntarily submits specific documents)
//         ↓
//   DatasetConsent    (patient provides explicit consent per requirement)
//         ↓
//   De-identification (PII stripped — name, phone, Aadhaar, address)
//         ↓
//   ApprovedDataset   (de-identified dataset snapshot, versioned)
//         ↓
//   DatasetAccessGrant (time-bounded access authorization)
//         ↓
//   Researcher accesses ApprovedDataset ONLY
//         ↓
//   DatasetAccessLog  (immutable audit trail)
//
// Buyers / researchers NEVER receive foreign keys to:
//   patients, encounters, clinical_notes, prescriptions,
//   lab_results, imaging_studies, or any live EHR entity.

model Buyer {
  id          String   @id @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  companyName String   @map("company_name") @db.VarChar(255)
  description String?
  website     String?  @db.VarChar(255)
  phone       String?  @db.VarChar(32)
  address     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements        ResearchRequirement[]
  datasetAccessGrants DatasetAccessGrant[]
  // Audit: direct back-relation from DatasetAccessLog for compliance queries
  datasetAccessLogs   DatasetAccessLog[]

  @@map("buyers")
}

model ResearchRequirement {
  id               String   @id @db.Uuid
  buyerId          String   @map("buyer_id") @db.Uuid
  title            String   @db.VarChar(255)
  targetSampleSize String   @map("target_sample_size") @db.VarChar(100) // e.g. "500 patients"
  dataNeeded       String   @map("data_needed")
  description      String
  pricing          Json     @default("{\"prescriptions\":0,\"scans\":0,\"xrays\":0,\"labReports\":0}")
  requiredDocs     String[] @map("required_docs")
  status           String   @default("active") @db.VarChar(32) // active, closed, completed
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  buyer       Buyer                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  submissions DatasetSubmission[]
  messages    MarketplaceMessage[]
  datasetConsents     DatasetConsent[]
  approvedDatasets    ApprovedDataset[]

  @@index([buyerId])
  @@index([status])
  @@map("research_requirements")
}

model DatasetSubmission {
  id            String   @id @db.Uuid
  requirementId String   @map("requirement_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  patientName   String?  @map("patient_name") @db.VarChar(100)
  status        String   @default("pending") @db.VarChar(32) // pending, accepted, rejected, paid
  payoutAmount  Decimal  @default(0.00) @map("payout_amount") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  requirement ResearchRequirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  documents   SubmissionDocument[]
  datasetConsents DatasetConsent[]

  @@index([requirementId])
  @@index([patientId])
  @@map("dataset_submissions")
}

model SubmissionDocument {
  id           String   @id @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  type         String   @db.VarChar(32) // prescriptions, scans, xrays, labReports, images
  fileUrl      String   @map("file_url")
  fileName     String?  @map("file_name") @db.VarChar(255)
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  submission DatasetSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_documents")
}

model MarketplaceMessage {
  id            String   @id @db.Uuid
  requirementId String?  @map("requirement_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  receiverId    String   @map("receiver_id") @db.Uuid
  content       String
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  requirement ResearchRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  sender      User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                 @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@map("marketplace_messages")
}

// ─────────────────────────────────────────────────────────────
// 12b. RESEARCH DATASET CONSENT & ACCESS CONTROL
//      (Air-gapped from clinical EHR authorization)
// ─────────────────────────────────────────────────────────────

enum DatasetConsentStatus {
  pending
  granted
  revoked
  expired
}

// DatasetConsent: Patient's explicit consent for a specific research requirement.
// This is completely separate from clinical Consent.
// A patient must grant DatasetConsent before their submission can be de-identified
// and assembled into an ApprovedDataset for buyer access.
model DatasetConsent {
  id            String              @id @db.Uuid
  submissionId  String              @map("submission_id") @db.Uuid
  patientId     String              @map("patient_id") @db.Uuid
  requirementId String              @map("requirement_id") @db.Uuid
  // Scopes explicitly consented to, e.g. ["prescriptions", "lab_reports", "scans"]
  consentScopes String[]            @map("consent_scopes")
  status        DatasetConsentStatus @default(pending)
  validFrom     DateTime            @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil    DateTime?           @map("valid_until") @db.Timestamptz(6)
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  submission    DatasetSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  requirement   ResearchRequirement  @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  approvedDatasets ApprovedDataset[]

  @@index([patientId])
  @@index([requirementId])
  @@map("dataset_consents")
}

enum ApprovedDatasetStatus {
  pending_review
  approved
  rejected
  expired
}

enum DeidentificationStatus {
  not_started
  in_progress
  completed
  failed
}

// ApprovedDataset: The de-identified dataset snapshot produced after consent and review.
// Buyers never receive direct patient identifiers — they only access ApprovedDatasets.
// This record is versioned so re-runs of de-identification produce traceable versions.
model ApprovedDataset {
  id                    String                 @id @db.Uuid
  requirementId         String                 @map("requirement_id") @db.Uuid
  datasetConsentId      String                 @map("dataset_consent_id") @db.Uuid
  status                ApprovedDatasetStatus  @default(pending_review)
  version               Int                    @default(1)
  deidentificationStatus DeidentificationStatus @default(not_started) @map("deidentification_status")
  // storageRef holds the reference to the de-identified data artifact (e.g. S3 key, internal path)
  storageRef            String?                @map("storage_ref") @db.VarChar(512)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt             DateTime?              @map("expires_at") @db.Timestamptz(6)

  requirement    ResearchRequirement   @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  datasetConsent DatasetConsent        @relation(fields: [datasetConsentId], references: [id], onDelete: Restrict)
  accessGrants   DatasetAccessGrant[]
  // Audit: direct back-relation from DatasetAccessLog for queryability
  accessLogs     DatasetAccessLog[]

  @@index([requirementId])
  @@map("approved_datasets")
}

enum DatasetAccessGrantStatus {
  active
  revoked
  expired
}

// DatasetAccessGrant: Time-bounded authorization for a buyer to access an ApprovedDataset.
// Grants are per-dataset and per-buyer. Access automatically expires at validUntil.
model DatasetAccessGrant {
  id        String                  @id @db.Uuid
  datasetId String                  @map("dataset_id") @db.Uuid
  buyerId   String                  @map("buyer_id") @db.Uuid
  // Purpose captures the declared research intent for this access grant
  purpose   String                  @db.VarChar(255)
  status    DatasetAccessGrantStatus @default(active)
  validFrom DateTime                @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime?              @map("valid_until") @db.Timestamptz(6)
  revokedAt DateTime?               @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  dataset    ApprovedDataset      @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  buyer      Buyer                @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  accessLogs DatasetAccessLog[]

  @@index([datasetId])
  @@index([buyerId])
  @@map("dataset_access_grants")
}

// DatasetAccessLog: Immutable audit trail of all buyer access to approved research datasets.
// Logs are append-only — no cascade deletes on this table.
//
// Relational integrity (Phase 1.2):
//   - accessGrantId: primary navigation key (grant carries dataset + buyer context)
//   - datasetId:     direct FK to ApprovedDataset for fast per-dataset audit queries
//   - buyerId:       direct FK to Buyer for fast per-buyer compliance queries
// Both datasetId and buyerId are also carried on the DatasetAccessGrant, but
// duplicate FK columns here provide O(1) indexed audit lookups without a join.
model DatasetAccessLog {
  id              String   @id @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  accessGrantId   String   @map("access_grant_id") @db.Uuid
  buyerId         String   @map("buyer_id") @db.Uuid
  // action describes what the buyer did: e.g. download, view, export
  action          String   @db.VarChar(64)
  // ipAddress and userAgent for compliance and forensics
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.VarChar(512)
  requestMetadata Json?    @map("request_metadata") // additional structured request context
  accessedAt      DateTime @default(now()) @map("accessed_at") @db.Timestamptz(6)

  // Prisma relations — enforce FK integrity at the database level
  accessGrant DatasetAccessGrant @relation(fields: [accessGrantId], references: [id], onDelete: Restrict)
  dataset     ApprovedDataset    @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  buyer       Buyer              @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([datasetId, accessedAt])
  @@index([buyerId])
  @@map("dataset_access_logs")
}
